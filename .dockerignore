# For images built from the repository root (the backend: it needs
# database/prisma/schema too). Keep the context to what it uses.
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
.git
frontend
database/src
backend/prisma
# Never bake secrets or database dumps into an image layer, wherever they are.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.dump
**/*.sql
**/*.sql.gz

MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=aios
MYSQL_USER=aios
MYSQL_PASSWORD=aios_dev_password
MYSQL_PORT=3306

DATABASE_URL=mysql://aios:aios_dev_password@mysql:3306/aios

BACKEND_PORT=4000
FRONTEND_PORT=5173

VITE_API_URL=http://localhost:4000

GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
JWT_SECRET=<some-long-random-string>

# Optional in development, required in production (NODE_ENV=production).
# Browser origins allowed to call the API, comma-separated. Unset in dev = any origin.
CORS_ORIGIN=http://localhost:5173
# Who may use admin mode, comma-separated. Unset in dev = everyone; unset in production = nobody.
ADMIN_EMAILS=

# AI advice on the results page, from NTNU's IDUN LLM service (OpenAI-compatible).
# Leave LLM_API_KEY empty to turn the feature off. Request a personal key at
# https://ai.hpc.ntnu.no/request-api-key — never commit it. Only reachable from
# NTNU's network or VPN. The two below are optional; these are the defaults.
LLM_API_KEY=
# LLM_BASE_URL=https://llm.hpc.ntnu.no/v1
# LLM_MODEL=openai/gpt-oss-120b

# The Moodle site learning material lives on. Module and journey links are
# built from it plus each one's (placeholder) course id in the seed data.
MOODLE_BASE_URL=https://moodle.example.org

# --- On the VM (https://aios.idi.ntnu.no, behind nginx) ---
# nginx serves the frontend and forwards /api/ to the backend with the prefix
# stripped (proxy_pass http://127.0.0.1:4000/;). Ports 4000/5173 are not
# reachable from outside, and an https page may not call an http API, so:
#   VITE_API_URL=https://aios.idi.ntnu.no/api
#   CORS_ORIGIN=https://aios.idi.ntnu.no
# The Google OAuth client must list https://aios.idi.ntnu.no as an
# Authorized JavaScript origin.

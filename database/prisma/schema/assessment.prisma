/// Assessment module — the content hierarchy (competence, section, module),
/// the question bank, self-assessment runs, answers and derived scores.
/// Tables: assessment_*.
///
/// History outlives content: a learner's completed SATs must stay readable
/// after questions, competences, sections or journeys are removed. So
/// answers and scores only *link* to content (set to null when it's
/// deleted, never blocking the delete), and everything History displays is
/// also copied onto the instance/score when it's recorded (the *Name
/// fields below).
///
/// Hierarchy: a Section (A–E) contains SectionModules at levels 1–4 (A1 the
/// easiest … A4 the most advanced); each SectionModule has one
/// main Competence plus any number of secondary ones (join table). Questions
/// hang off a SectionModule and name the Competence they assess directly —
/// scores roll up by that competenceId, not through the hierarchy.

model Competence {
  id              String  @id @default(uuid())
  name            String  @unique
  description     String? @db.Text
  /// The main learning resource for it, when one is known. Optional: the
  /// WP2 curriculum points learners at Moodle modules instead (SectionModule.moodleUrl).
  primarySourceId String?
  primarySource   Source? @relation(fields: [primarySourceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secondarySources    CompetenceSecondarySource[]
  mainForModules      SectionModule[]
  secondaryForModules SectionModuleSecondaryCompetence[]
  questions           Question[]
  competenceScores    CompetenceScore[]
  roleGrants          RoleCompetence[]

  @@map("assessment_competence")
}

/// Extra sources that also build a competence (the primary one is a plain FK).
model CompetenceSecondarySource {
  competenceId String
  competence   Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  sourceId     String
  source       Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([competenceId, sourceId])
  @@map("assessment_competence_secondary_source")
}

model Section {
  id          String  @id @default(uuid())
  /// Short letter, "A"–"E". Nullable only so it could be added to existing rows.
  code        String? @unique
  name        String  @unique
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules         SectionModule[]
  roleGrants      RoleSection[]
  journeySections JourneySection[]
  satInstances    SatInstanceSection[]

  @@map("assessment_section")
}

model SectionModule {
  id               String     @id @default(uuid())
  name             String     @unique
  description      String?    @db.Text
  mainCompetenceId String
  mainCompetence   Competence @relation(fields: [mainCompetenceId], references: [id])
  sectionId        String
  section          Section    @relation(fields: [sectionId], references: [id])
  /// 1 (easiest) to 4 (most advanced) within its section: with the section's
  /// code, A1 … A4. The assessment only moves up a level after a learner
  /// gets 2 of 3 right on the one below (see assessment.path.ts). Nullable
  /// only so it could be added to existing rows; unleveled modules come last.
  level            Int?
  /// Where the learning material for this module sits in Moodle ("soft"
  /// integration: AIOS only links to it). Placeholders until the real URLs
  /// exist — see MOODLE_BASE_URL and the seed data's moodleCourseId.
  moodleUrl        String?    @db.VarChar(512)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secondaryCompetences SectionModuleSecondaryCompetence[]
  questions            Question[]

  @@unique([sectionId, level])
  @@map("assessment_section_module")
}

/// Extra competences a module also touches (the main one is a plain FK).
model SectionModuleSecondaryCompetence {
  moduleId     String
  module       SectionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  competenceId String
  competence   Competence    @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@id([moduleId, competenceId])
  @@map("assessment_section_module_secondary_competence")
}

model Question {
  id              String        @id @default(uuid())
  prompt          String        @db.Text
  questionType    String // "likert" | "single_choice" | "multi_choice" | "true_false" — see assessment.pie.ts
  content         Json // PIE item content (elements / models / markup)
  sectionModuleId String
  sectionModule   SectionModule @relation(fields: [sectionModuleId], references: [id])
  competenceId    String
  competence      Competence    @relation(fields: [competenceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses Response[]
  views     QuestionView[]

  @@map("assessment_question")
}

model SatInstance {
  id                     String               @id @default(uuid())
  learnerId              String
  learner                Learner              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  /// "main": the self-assessment (initial + retakes) — the only kind the
  /// dashboard, History, progress, advice and recommendations read.
  /// "journey": a learner assessing one learning journey's sections on its
  /// own; it never counts towards the main results (see assessedJourney).
  kind                   String               @default("main")
  instanceNum            Int // sequence number for this learner within its kind: main 1 = initial, 2+ = retakes
  startedAt              DateTime             @default(now())
  completedAt            DateTime?
  completedJourneyId     String?
  completedJourney       LearningJourney?     @relation("CompletedJourney", fields: [completedJourneyId], references: [id], onDelete: SetNull)
  completedJourneyName   String?
  /// kind "journey": the journey being assessed, and a copy of its name that
  /// outlives it. Limited to the journey's M sections (SatInstanceSection).
  assessedJourneyId      String?
  assessedJourney        LearningJourney?     @relation("AssessedJourney", fields: [assessedJourneyId], references: [id], onDelete: SetNull)
  assessedJourneyName    String?
  reassessedSectionNames Json?
  sections               SatInstanceSection[]
  responses              Response[]
  competenceScores       CompetenceScore[]
  advice                 Advice?

  @@unique([learnerId, kind, instanceNum])
  // Its own index for the learner foreign key: MySQL won't drop a unique key
  // that's the only index backing a foreign key, which blocked replacing the
  // old (learnerId, instanceNum) key with the per-kind one above.
  @@index([learnerId])
  @@map("assessment_sat_instance")
}

model SatInstanceSection {
  satInstanceId String
  satInstance   SatInstance @relation(fields: [satInstanceId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([satInstanceId, sectionId])
  @@map("assessment_sat_instance_section")
}

model Response {
  id            String      @id @default(uuid())
  satInstanceId String
  satInstance   SatInstance @relation(fields: [satInstanceId], references: [id], onDelete: Cascade)
  questionId    String?
  question      Question?   @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answer        Json
  score         Float?
  maxScore      Float?
  // Wall-clock time (ms) the question was on screen before this save, from
  // the frontend's own clock (CD-97). Null for responses saved before this
  // existed, or when the value the client sent wasn't plausible. Analytics
  // only — never used for scoring.
  timeSpentMs   Int?
  answeredAt    DateTime    @default(now())

  // One response per question per SAT instance — resubmitting (e.g. going
  // back and changing an answer before finishing) updates it in place.
  @@unique([satInstanceId, questionId])
  @@map("assessment_response")
}

model CompetenceScore {
  id             String      @id @default(uuid())
  satInstanceId  String
  satInstance    SatInstance @relation(fields: [satInstanceId], references: [id], onDelete: Cascade)
  competenceId   String?
  competence     Competence? @relation(fields: [competenceId], references: [id], onDelete: SetNull)
  competenceName String?
  sectionCode    String?
  sectionName    String?
  level          Int?
  score          Float
  maxScore       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([satInstanceId, competenceId])
  @@map("assessment_competence_score")
}

/// A question being shown to a learner during an attempt (CD-125), recorded
/// the first time only. Keyed to the attempt — (learnerId, kind, instanceNum),
/// the same numbering SatInstance uses — rather than to a SatInstance, because
/// the instance is only created by the first saved answer: a learner who opens
/// the first question and leaves has views but no instance. Aggregate-only
/// analytics (the admin drop-off page); never shown per learner.
model QuestionView {
  id          String    @id @default(uuid())
  learnerId   String
  learner     Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  kind        String    @default("main")
  instanceNum Int
  questionId  String?
  question    Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  viewedAt    DateTime  @default(now())

  // First view only — going Back to a question is not a new view.
  @@unique([learnerId, kind, instanceNum, questionId])
  @@map("assessment_question_view")
}

/// Identity module — accounts, Google sign-in, the persona role a learner
/// picks during onboarding, and the role visibility allow-lists (which
/// sections / competences a role may see). Tables: identity_*.

model Learner {
  id                            String   @id @default(uuid())
  email                         String?  @unique // null once the personal data is deleted (see deletedAt)
  name                          String?
  googleSubId                   String?  @unique // "sub" claim from Google's ID token; null once deleted
  orcidId                       String?  @unique // the learner's ORCID iD, e.g. 0000-0002-1825-0097; null once deleted
  roleId                        String? // chosen persona (identity_role)
  userRole                      Role?    @relation(fields: [roleId], references: [id])
  hasCompletedInitialAssessment Boolean  @default(false) // true once every visible question in the first SAT instance is answered
  privacyNoticeAcceptedAt       DateTime? // set when the learner ticks the information-letter checkbox on the profile step
  /// Set when the learner deletes their account in Settings: their personal
  /// data is deleted at this time (30 days later), unless they cancel first.
  deletionScheduledFor          DateTime?
  /// Set once the personal data has been deleted. The row stays, so the
  /// learner's assessments still count in the research data, but it no
  /// longer identifies anyone and can't be signed in to.
  deletedAt                     DateTime?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  satInstances    SatInstance[]
  questionViews   QuestionView[]
  profile          LearnerProfile?
  recommendations  JourneyRecommendation[]
  sectionGrants    RoleSection[]
  competenceGrants RoleCompetence[]
  feedback         Feedback[]
  auditEvents      AuditEvent[]

  @@map("identity_learner")
}

/// Persona a learner selects after signing in, before starting a journey. Also
/// the subject of the visibility allow-lists below: a role only sees what it
/// has been granted.
model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learners         Learner[]
  sectionGrants    RoleSection[]
  competenceGrants RoleCompetence[]

  @@map("identity_role")
}

/// Learner-stated context (SAT23), industry, academic degree, background,
/// years of experience and goals, which must be filled in before taking the
/// assessment. The name lives on Learner. Fed to the AI advice;
/// recommendJourney() doesn't read it yet (see CD-28).
model LearnerProfile {
  id                String   @id @default(uuid())
  learnerId         String   @unique
  learner           Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  industry          String?
  academicDegree    String?
  background        String?  @db.Text
  yearsOfExperience Int?
  goals             String?  @db.Text
  updatedAt         DateTime @updatedAt

  @@map("identity_learner_profile")
}

/// Allow-list: this role may see the questions inside this section's modules.
model RoleSection {
  roleId             String
  role               Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sectionId          String
  section            Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  grantedByLearnerId String?
  grantedBy          Learner? @relation(fields: [grantedByLearnerId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  @@id([roleId, sectionId])
  @@map("identity_role_section")
}

/// Allow-list: this role may see the questions that assess this competence.
model RoleCompetence {
  roleId             String
  role               Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  competenceId       String
  competence         Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  grantedByLearnerId String?
  grantedBy          Learner?   @relation(fields: [grantedByLearnerId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())

  @@id([roleId, competenceId])
  @@map("identity_role_competence")
}

{
  "_meta": {
    "description": "FAKE food-themed seed data for AIOS (schema v3, role visibility). Everything here is obviously fake. No SAT instances, responses, scores or recommendations are included, so a freshly logged-in learner starts with all questions unanswered.",
    "insertOrder": [
      "aios.sources.source",
      "aios.identity.role",
      "aios.assessment.competence",
      "aios.assessment.competence_secondary_source",
      "aios.assessment.section",
      "aios.assessment.section_module",
      "aios.assessment.section_module_secondary_competence",
      "aios.assessment.question",
      "aios.learningJourney.journey",
      "aios.learningJourney.journey_section",
      "aios.learningJourney.learning_module",
      "aios.identity.learner",
      "aios.identity.role_section",
      "aios.identity.role_competence"
    ],
    "questionTypes": {
      "likert": "content.scale {min,max,minLabel,maxLabel}; self-rated, score = chosen value",
      "single_choice": "content.options[] + correctOptionIds (one)",
      "multi_choice": "content.options[] + correctOptionIds (several), 1 point per correct pick",
      "true_false": "content.options true/false + correctOptionIds"
    },
    "intentionallyEmpty": [
      "aios.assessment.sat_instance",
      "aios.assessment.response",
      "aios.assessment.competence_score",
      "aios.learningJourney.recommendation"
    ]
  },

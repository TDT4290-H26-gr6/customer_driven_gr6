/// Identity module — accounts, Google sign-in, and the persona role a learner
/// picks during onboarding. Tables: identity_*.

model Learner {
  id                            String   @id @default(uuid())
  email                         String   @unique
  name                          String?
  googleSubId                   String?  @unique // "sub" claim from Google's ID token
  role                          String   @default("learner") // system role: "learner" | "admin"
  roleId                        String? // chosen persona (identity_role): student, librarian, CEO, ...
  userRole                      Role?    @relation(fields: [roleId], references: [id])
  hasCompletedInitialAssessment Boolean  @default(false) // true once every question in SAT instance 1 has been answered
  createdAt                     DateTime @default(now())

  satInstances SatInstance[]
  profile      LearnerProfile?

  @@map("identity_learner")
}

/// Persona a learner selects after signing in, before starting a journey.
model Role {
  id       String    @id @default(uuid())
  name     String    @unique
  learners Learner[]

  @@map("identity_role")
}

/// Learner-stated context (SAT23): goals, background, years of experience.
/// Collected so a future recommendation rule can factor in what the learner
/// says they want, not just their measured weakest area — data only for
/// now, recommendJourney() doesn't read this yet (see CD-28).
model LearnerProfile {
  id                String   @id @default(uuid())
  learnerId         String   @unique
  learner           Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  goals             String?  @db.Text
  background        String?  @db.Text
  yearsOfExperience Int?
  updatedAt         DateTime @updatedAt

  @@map("identity_learner_profile")
}

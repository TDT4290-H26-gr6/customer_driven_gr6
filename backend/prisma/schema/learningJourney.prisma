/// Learning Journey module — curated module sequences a learner can follow,
/// the sections each journey covers, and the score-based recommendation that
/// points a learner at one. Tables: learning_journey_*.

enum CoverageLevel {
  M // main: the journey is centred on this section
  R // recommended: covers the section well
  S // supplementary: touches on it
}

model LearningJourney {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules            LearningModule[]
  sections           JourneySection[]
  recommendations    JourneyRecommendation[]
  selectedByLearners Learner[]               @relation("LearnerSelectedJourney")
  satInstances       SatInstance[]

  @@map("learning_journey_journey")
}

/// Which sections a journey covers, and how strongly. The recommendation
/// picks the journey with the best coverage of the learner's weakest area.
model JourneySection {
  journeyId     String
  journey       LearningJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  coverageLevel CoverageLevel
  createdAt     DateTime        @default(now())

  @@id([journeyId, sectionId])
  @@map("learning_journey_journey_section")
}

/// One step in a journey. Its content can be a Source (optional).
model LearningModule {
  id          String          @id @default(uuid())
  journeyId   String
  journey     LearningJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String?         @db.Text
  sourceId    String?
  source      Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([journeyId, order])
  @@map("learning_journey_learning_module")
}

model JourneyRecommendation {
  id        String          @id @default(uuid())
  learnerId String
  learner   Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  journeyId String
  journey   LearningJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  reason    String?         @db.Text
  createdAt DateTime        @default(now())

  @@map("learning_journey_recommendation")
}

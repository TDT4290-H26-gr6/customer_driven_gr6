/// Sources module — third-party learning resources (formal courses, training
/// programmes, institutional initiatives) that build a competence. A source is
/// a competence's primary or secondary source and can be the content behind a
/// learning-journey step. Tables: sources_*.

model Source {
  id              String   @id @default(uuid())
  institution     String
  country         String
  courseName      String
  type            String // "course" | "Formal university course" | "Support service / training programme" | ...
  level           String? // e.g. "bachelor", "master"
  degreeProgramme String?
  credits         Decimal? @db.Decimal(5, 2)
  language        String?
  instructor      String?
  format          String?
  topics          String?  @db.Text // comma-separated
  prerequisites   String?  @db.Text
  description     String?  @db.Text
  sourceUrl       String   @unique @db.VarChar(512)
  confidence      Float? // 0..1 — how sure we are the source is real / still current

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryForCompetences   Competence[]
  secondaryForCompetences CompetenceSecondarySource[]
  learningModules         LearningModule[]

  @@map("sources_source")
}

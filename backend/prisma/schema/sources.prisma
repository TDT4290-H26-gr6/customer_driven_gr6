/// Courses module — third-party learning resources (formal courses, training
/// programmes, institutional initiatives) a learner can take to build a
/// competence area. Tables: courses_*.

model Course {
  id              String   @id @default(uuid())
  institution     String
  country         String
  name            String
  type            String // "Formal university course" | "Support service / training programme" | "Institutional initiative" | "Research group / EU project involvement" | ...
  level           String? // e.g. "Master's (Laurea Magistrale)", "N/A (open to all researchers)"
  degreeProgramme String?
  credits         String? // free text, e.g. "6 ECTS"
  language        String?
  instructor      String?
  format          String?
  topics          String? @db.Text // comma-separated
  prerequisites   String? @db.Text
  description     String? @db.Text
  sourceUrl       String  @unique @db.VarChar(512)
  confidence      String? @db.Text // data-quality note, e.g. "Confirmed — named, credit-bearing course"

  createdAt DateTime @default(now())

  @@map("courses_course")
}

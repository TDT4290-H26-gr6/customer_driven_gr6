/// Advisor module — AI-written advice shown on the dashboard: an
/// explanation of the learner's results, 1–3 next steps (Moodle modules),
/// and the two learning journeys that fit them best — ranked on their scores
/// and their profile — among those covering their weak sections. Generated once per completed SAT instance by the
/// NTNU IDUN LLM and stored, so revisiting the page doesn't call the LLM
/// again. Tables: advisor_*.

model Advice {
  id                    String           @id @default(uuid())
  satInstanceId         String           @unique
  satInstance           SatInstance      @relation(fields: [satInstanceId], references: [id], onDelete: Cascade)
  summary               String           @db.Text
  /// The recommended next steps, resolved when generated so later catalogue
  /// edits don't rewrite past advice:
  /// [{ kind: "moodle_module" | "module" | "source", id, title, url: string | null, reason }]
  steps                 Json
  /// The journey the AI ranked as the best fit for this learner (scores +
  /// profile), or null when there was none to choose from. The dashboard
  /// shows it as the highlighted recommendation.
  journeyId             String?
  journey               LearningJourney? @relation("AdviceBestJourney", fields: [journeyId], references: [id], onDelete: SetNull)
  /// Why it fits them, in the AI's words; null when the app fell back to
  /// the score-based pick.
  journeyReason         String?          @db.Text
  /// The second-best fit, shown smaller beside it; null when there was only
  /// one journey to choose from (or for advice written before ranking).
  runnerUpJourneyId     String?
  runnerUpJourney       LearningJourney? @relation("AdviceRunnerUpJourney", fields: [runnerUpJourneyId], references: [id], onDelete: SetNull)
  runnerUpJourneyReason String?          @db.Text
  model                 String // which LLM wrote it, e.g. "openai/gpt-oss-120b"
  createdAt             DateTime         @default(now())

  @@map("advisor_advice")
}

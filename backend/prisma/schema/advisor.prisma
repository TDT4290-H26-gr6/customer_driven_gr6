/// Advisor module — AI-written advice shown on the results page: an
/// explanation of the learner's results, 1–3 next steps (Moodle modules),
/// and the learning journey that best fits their role among those covering
/// their weak sections. Generated once per completed SAT instance by the
/// NTNU IDUN LLM and stored, so revisiting the page doesn't call the LLM
/// again. Tables: advisor_*.

model Advice {
  id            String           @id @default(uuid())
  satInstanceId String           @unique
  satInstance   SatInstance      @relation(fields: [satInstanceId], references: [id], onDelete: Cascade)
  summary       String           @db.Text
  /// The recommended next steps, resolved when generated so later catalogue
  /// edits don't rewrite past advice:
  /// [{ kind: "moodle_module" | "module" | "source", id, title, url: string | null, reason }]
  steps         Json
  /// The journey the AI chose for this learner (role-aware), or null when
  /// there was none to choose from. The dashboard shows it instead of the
  /// score-based pick, unless the learner selected a journey themselves.
  journeyId     String?
  journey       LearningJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  /// Why it fits them, in the AI's words; null when the app fell back to
  /// the score-based pick.
  journeyReason String?          @db.Text
  model         String // which LLM wrote it, e.g. "openai/gpt-oss-120b"
  createdAt     DateTime         @default(now())

  @@map("advisor_advice")
}

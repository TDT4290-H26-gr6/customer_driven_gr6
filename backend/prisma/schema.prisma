// Starter schema — covers just enough to unblock sprint 1.
// Flesh this out together as a team before building the SAT/LJ features
// (see README "Next steps"). Field names are drafts, not final.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Learner {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  googleSubId  String?  @unique // "sub" claim from Google's ID token
  role         String   @default("learner") // "learner" | "admin"
  createdAt    DateTime @default(now())

  satInstances SatInstance[]
}

model CompetenceArea {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text

  questions   Question[]
}

model Question {
  id               String   @id @default(uuid())
  competenceAreaId String
  competenceArea   CompetenceArea @relation(fields: [competenceAreaId], references: [id])
  prompt           String   @db.Text
  questionType     String   // "self_rating" | "behavioral_anchor" | "rubric"
  // Full item content (options, rubric criteria, etc.) — the exact shape
  // will depend on the PIE item format once that's wired up.
  content          Json

  responses        Response[]
}

model SatInstance {
  id          String   @id @default(uuid())
  learnerId   String
  learner     Learner  @relation(fields: [learnerId], references: [id])
  instanceNum Int      // 1 = before curriculum, 2 = after (SAT16)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  responses         Response[]
  competenceScores  CompetenceScore[]
}

model Response {
  id            String   @id @default(uuid())
  satInstanceId String
  satInstance   SatInstance @relation(fields: [satInstanceId], references: [id])
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])
  answer        Json
  score         Float?
  answeredAt    DateTime @default(now())
}

model CompetenceScore {
  id               String   @id @default(uuid())
  satInstanceId    String
  satInstance      SatInstance @relation(fields: [satInstanceId], references: [id])
  competenceAreaId String
  score            Float
}

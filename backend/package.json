{
  "name": "aios-backend",
  "version": "0.1.0",
  "private": true,
  "license": "LGPL-3.0-only",
  "contributors": [
    "Ragnar Dreier",
    "Mats Albert Kamps",
    "Oda Aasen Kjerstad",
    "Daniel Duy Nguyen",
    "Arman Zanjani"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "node -e \"const fs=require('fs');fs.rmSync('prisma',{recursive:true,force:true});fs.cpSync('../database/prisma/schema','prisma/schema',{recursive:true})\" && prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "schema": "./prisma/schema"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^9.14.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.9",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "prisma": "^5.19.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.1.9"
  }
}
